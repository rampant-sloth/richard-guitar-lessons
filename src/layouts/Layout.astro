---
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  active?: 'home' | 'kids' | 'adults' | 'about' | 'book';
}

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  active = 'home',
} = Astro.props;

const [settingsEntry] = await getCollection('site');
const settings = settingsEntry?.data;

type NavPage = 'home' | 'kids' | 'adults' | 'about';

function desktopNavClass(page: NavPage) {
  return active === page
    ? 'text-emerald-600 dark:text-emerald-400'
    : 'transition hover:text-emerald-600 dark:hover:text-emerald-400';
}

function mobileNavClass(page: NavPage) {
  return active === page
    ? 'rounded-lg bg-slate-100 dark:bg-slate-800 px-3 py-2.5 font-semibold text-emerald-700 dark:text-emerald-400'
    : 'rounded-lg px-3 py-2.5 hover:bg-slate-100 dark:hover:bg-slate-800';
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#059669" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>
      // Default to dark mode, but honour an explicit light-mode preference.
      (function () {
        var mq = window.matchMedia('(prefers-color-scheme: light)');
        function apply() {
          var dark = !mq.matches;
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        }
        apply();
        if (mq.addEventListener) { mq.addEventListener('change', apply); }
      })();
    </script>
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>tailwind.config = { darkMode: 'class' };</script>
    <!-- cal.com embed intentionally removed until the booking account is set up (see README) -->
  </head>
  <body class="bg-white text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header class="sticky top-0 z-50 border-b border-slate-200 dark:border-slate-700 bg-white/95 dark:bg-slate-950/95 backdrop-blur">
      <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
        <a href="/" class="flex items-center gap-2.5" aria-label="Richard's Guitar Lessons — home">
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-600 text-xl" aria-hidden="true">🎸</span>
          <span class="text-sm font-bold leading-tight text-slate-900 dark:text-white">Richard's<br />Guitar Lessons</span>
        </a>
        <nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 dark:text-slate-300 md:flex" aria-label="Primary">
          <a href="/" class={desktopNavClass('home')} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href="/online-guitar-lessons-kids" class={desktopNavClass('kids')} aria-current={active === 'kids' ? 'page' : undefined}>Kids &amp; Exams</a>
          <a href="/adult-online-guitar-lessons" class={desktopNavClass('adults')} aria-current={active === 'adults' ? 'page' : undefined}>Adults &amp; Hobbyists</a>
          <a href="/about-richard" class={desktopNavClass('about')} aria-current={active === 'about' ? 'page' : undefined}>About</a>
          <a href="/book-trial-lesson" class={active === 'book' ? 'rounded-lg bg-emerald-700 px-4 py-2 font-semibold text-white shadow-sm transition hover:bg-emerald-800' : 'rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white shadow-sm transition hover:bg-emerald-700'} aria-current={active === 'book' ? 'page' : undefined}>Book a Trial</a>
        </nav>
        <button id="menu-toggle" type="button" class="inline-flex items-center justify-center rounded-lg p-2 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 md:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Toggle navigation menu">
          <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
          <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <div id="mobile-menu" class="hidden border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 px-4 pb-4 pt-2 md:hidden">
        <nav class="flex flex-col gap-1 text-sm font-medium text-slate-700 dark:text-slate-200" aria-label="Mobile">
          <a href="/" class={mobileNavClass('home')} aria-current={active === 'home' ? 'page' : undefined}>Home</a>
          <a href="/online-guitar-lessons-kids" class={mobileNavClass('kids')} aria-current={active === 'kids' ? 'page' : undefined}>Kids &amp; Exams</a>
          <a href="/adult-online-guitar-lessons" class={mobileNavClass('adults')} aria-current={active === 'adults' ? 'page' : undefined}>Adults &amp; Hobbyists</a>
          <a href="/about-richard" class={mobileNavClass('about')} aria-current={active === 'about' ? 'page' : undefined}>About</a>
          <a href="/book-trial-lesson" class="mt-1 rounded-lg bg-emerald-600 px-3 py-2.5 font-semibold text-white hover:bg-emerald-700">Book a Trial</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="bg-slate-900 text-slate-400">
      <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <div class="flex items-center gap-2.5">
              <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-600 text-lg" aria-hidden="true">🎸</span>
              <span class="text-sm font-bold text-white">Richard's Guitar Lessons</span>
            </div>
            <p class="mt-4 text-sm leading-relaxed">{settings?.tagline ?? 'Friendly, structured online guitar lessons for all ages — from grade exams to playing your favourite songs.'}</p>
          </div>
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Lessons</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li><a href="/online-guitar-lessons-kids" class="hover:text-emerald-400">Kids &amp; Exams</a></li>
              <li><a href="/adult-online-guitar-lessons" class="hover:text-emerald-400">Adults &amp; Hobbyists</a></li>
              <li><a href="/book-trial-lesson" class="hover:text-emerald-400">Book a Trial</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Company</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li><a href="/about-richard" class="hover:text-emerald-400">About Richard</a></li>
              <li><a href="/" class="hover:text-emerald-400">Home</a></li>
            </ul>
          </div>
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wider text-white">Contact</h2>
            <ul class="mt-4 space-y-2.5 text-sm">
              <li><a href={`mailto:${settings?.contactEmail ?? 'hello@richardguitarlessons.com'}`} class="hover:text-emerald-400">{settings?.contactEmail ?? 'hello@richardguitarlessons.com'}</a></li>
              <li class="text-slate-500 dark:text-slate-400">Lessons via {settings?.platforms ?? 'Zoom (preferred), Teams, Google Meet or WhatsApp'}</li>
            </ul>
          </div>
        </div>
        <div class="mt-10 flex flex-col gap-2 border-t border-slate-800 pt-6 text-xs text-slate-500 dark:text-slate-400 sm:flex-row sm:items-center sm:justify-between">
          <p>© <span id="year"></span> Richard's Guitar Lessons. All rights reserved.</p>
          <p>Online guitar lessons for all ages.</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('icon-open');
      const iconClose = document.getElementById('icon-close');
      toggle.addEventListener('click', function () {
        const isOpen = !menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden', !isOpen);
        iconClose.classList.toggle('hidden', isOpen);
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
      document.getElementById('year').textContent = new Date().getFullYear();
    </script>
  </body>
</html>

