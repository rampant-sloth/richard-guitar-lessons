---
// Reusable image + text block used for the alternating split and featured sections.
// Renders as a two-column split (image first or second) that condenses to a single
// column below `lg`. The image can be a rounded card, a circle or an "arch" shape,
// with a faint offset accent behind it so it doesn't sit flat against the page.
interface Props {
  image?: string;
  imageAlt?: string;
  eyebrow?: string;
  title?: string;
  text?: string;
  reverse?: boolean;
  shape?: 'rounded' | 'circle' | 'arch';
}

const { image, imageAlt = '', eyebrow, title, text, reverse = false, shape = 'rounded' } = Astro.props;

const shapeClass =
  shape === 'circle' ? 'rounded-full' : shape === 'arch' ? 'rounded-t-full' : 'rounded-2xl';
---

<div class={`grid items-center gap-8 ${image ? 'lg:grid-cols-2' : ''}`}>
  {image && (
    <div class={reverse ? 'lg:order-2' : ''}>
      <figure class="relative">
        <div class={`absolute -inset-3 rounded-3xl bg-[var(--theme-accent-pale)] dark:bg-[var(--theme-surface)] ${reverse ? '-rotate-1' : 'rotate-1'}`} aria-hidden="true"></div>
        <img src={image} alt={imageAlt} loading="lazy" class={`relative w-full object-cover ${shapeClass} border border-[var(--theme-border)] shadow-lg`} />
      </figure>
    </div>
  )}
  <div class={image && reverse ? 'lg:order-1' : ''}>
    {eyebrow && <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">{eyebrow}</p>}
    {title && <h3 class="mt-3 text-2xl font-bold tracking-tight text-[var(--theme-text)]">{title}</h3>}
    {text && <p class="mt-4 leading-relaxed text-[var(--theme-muted)]">{text}</p>}
    <slot />
  </div>
</div>
