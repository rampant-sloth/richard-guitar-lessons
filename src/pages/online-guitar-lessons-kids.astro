---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import Cta from '../components/Cta.astro';
import LatestNews from '../components/LatestNews.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'kids');
if (!page) throw new Error('Missing src/content/pages/kids.yml');

const { seo, hero, sections, cta } = page.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Online guitar lessons for kids and exam students',
  provider: { '@type': 'Person', name: 'Richard', jobTitle: 'Online Guitar Teacher' },
  areaServed: 'Worldwide',
  url: 'https://richardguitarlessons.com/online-guitar-lessons-kids',
};
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://richardguitarlessons.com/online-guitar-lessons-kids"
  ogType="website"
  ogTitle={seo.ogTitle ?? seo.title}
  ogDescription={seo.ogDescription ?? seo.description}
  active="kids"
>
  <main>
    <Hero {...hero} />
    <Sections sections={sections} />
    <LatestNews />
    {cta && <Cta {...cta} />}
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
