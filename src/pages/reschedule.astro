---
import Layout from '../layouts/Layout.astro';

const FORMSPREE_ACTION = 'https://formspree.io/f/xnpjgokn';
const FORM_SUBJECT = 'Lesson reschedule request';

const seo = {
  title: 'Reschedule a Lesson | Richard\'s Guitar Lessons',
  description: 'Need to move a lesson to a different date or time? Fill in the form below and Richard will get back to you.',
};

const inputClass =
  'mt-1.5 block w-full rounded-lg border border-slate-300 dark:border-slate-600 bg-[var(--theme-surface)] px-4 py-2.5 text-[var(--theme-text)] shadow-sm placeholder:text-slate-400 dark:placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Reschedule a Lesson',
  url: 'https://richardguitarlessons.com/reschedule',
  mainEntity: {
    '@type': 'LocalBusiness',
    name: "Richard's Guitar Lessons",
    email: 'hello@richardguitarlessons.com',
  },
};
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://richardguitarlessons.com/reschedule"
  ogType="website"
  ogTitle={seo.title}
  ogDescription={seo.description}
  active="reschedule"
>
  <main>
    {/* Hero */}
    <section class="relative overflow-hidden bg-[var(--theme-band)]">
      <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
        <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">📅 Reschedule</p>
        <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-[var(--theme-text)] sm:text-5xl">Need to move a lesson?</h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--theme-muted)]">No problem — just fill in the form below with your current slot and the date/time you'd prefer, and I'll confirm the change within 24 hours.</p>
      </div>
    </section>

    {/* Form */}
    <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <div class="rounded-2xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6 shadow-sm sm:p-10">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold tracking-tight text-[var(--theme-text)] sm:text-3xl">Reschedule request</h2>
          <p class="mt-3 leading-relaxed text-[var(--theme-muted)]">Please give at least 24 hours' notice where possible. I'll confirm your new slot by email.</p>
        </div>
        <form action={FORMSPREE_ACTION} method="POST" class="mt-8 grid gap-5 sm:grid-cols-2">
          <input type="hidden" name="_subject" value={FORM_SUBJECT} />

          {/* Name */}
          <div>
            <label for="name" class="block text-sm font-semibold text-[var(--theme-text)]">Your name</label>
            <input type="text" id="name" name="name" required placeholder="e.g. Jamie Smith" class={inputClass} />
          </div>

          {/* Email */}
          <div>
            <label for="email" class="block text-sm font-semibold text-[var(--theme-text)]">Email address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" class={inputClass} />
          </div>

          {/* Original Lesson Date */}
          <div>
            <label for="originalDate" class="block text-sm font-semibold text-[var(--theme-text)]">Original lesson date</label>
            <input type="date" id="originalDate" name="originalDate" required class={inputClass} />
          </div>

          {/* Original Lesson Time */}
          <div>
            <label for="originalTime" class="block text-sm font-semibold text-[var(--theme-text)]">Original lesson time</label>
            <input type="time" id="originalTime" name="originalTime" required class={inputClass} />
          </div>

          {/* Proposed Reschedule Date */}
          <div>
            <label for="proposedDate" class="block text-sm font-semibold text-[var(--theme-text)]">Preferred new date</label>
            <input type="date" id="proposedDate" name="proposedDate" required class={inputClass} />
          </div>

          {/* Proposed Reschedule Time */}
          <div>
            <label for="proposedTime" class="block text-sm font-semibold text-[var(--theme-text)]">Preferred new time</label>
            <input type="time" id="proposedTime" name="proposedTime" required class={inputClass} />
          </div>

          {/* Optional notes */}
          <div class="sm:col-span-2">
            <label for="notes" class="block text-sm font-semibold text-[var(--theme-text)]">Anything else? <span class="font-normal text-[var(--theme-muted)]">(optional)</span></label>
            <textarea id="notes" name="notes" rows="3" placeholder="e.g. I have a clash that week, happy to swap with another student…" class={inputClass}></textarea>
          </div>

          <div class="sm:col-span-2">
            <button type="submit" class="rounded-lg bg-emerald-600 px-6 py-3 font-semibold text-white transition hover:bg-emerald-700">Submit reschedule request</button>
          </div>
        </form>
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>