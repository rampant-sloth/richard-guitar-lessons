---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import Cta from '../components/Cta.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.yml');

const { seo, hero, sections, cta } = page.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Richard',
  jobTitle: 'Online Guitar Teacher',
  description: seo.description,
  email: 'hello@richardguitarlessons.com',
  url: 'https://richardguitarlessons.com/about-richard',
};
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://richardguitarlessons.com/about-richard"
  ogType="profile"
  ogTitle={seo.ogTitle ?? seo.title}
  ogDescription={seo.ogDescription ?? seo.description}
  active="about"
>
  <main>
    <Hero {...hero} />
    <Sections sections={sections} />
    {cta && <Cta {...cta} />}
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
