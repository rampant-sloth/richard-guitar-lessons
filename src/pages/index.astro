---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import Cta from '../components/Cta.astro';
import LatestNews from '../components/LatestNews.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('Missing src/content/pages/home.yml');

const { seo, hero, sections, cta } = page.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: "Richard's Guitar Lessons",
  description: seo.description,
  url: 'https://richardguitarlessons.com/',
  email: 'hello@richardguitarlessons.com',
  areaServed: 'Worldwide',
  priceRange: '££',
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Online guitar lessons for kids and exam students' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Online guitar lessons for adults and hobbyists' } },
  ],
};
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://richardguitarlessons.com/"
  ogType="website"
  ogTitle={seo.ogTitle ?? seo.title}
  ogDescription={seo.ogDescription ?? seo.description}
  active="home"
>
  <main>
    <Hero {...hero} />
    <Sections sections={sections} />
    <LatestNews />
    {cta && <Cta {...cta} />}
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
