---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Sections from '../components/Sections.astro';
import Cta from '../components/Cta.astro';
import BookingForm from '../components/BookingForm.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'booking');
if (!page) throw new Error('Missing src/content/pages/booking.yml');

const { seo, hero, sections, cta, form } = page.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Book a Trial Guitar Lesson',
  url: 'https://richardguitarlessons.com/book-trial-lesson',
  mainEntity: {
    '@type': 'LocalBusiness',
    name: "Richard's Guitar Lessons",
    email: 'hello@richardguitarlessons.com',
  },
};
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://richardguitarlessons.com/book-trial-lesson"
  ogType="website"
  ogTitle={seo.ogTitle ?? seo.title}
  ogDescription={seo.ogDescription ?? seo.description}
  active="book"
>
  <main>
    <Hero {...hero} />
    {form && <BookingForm {...form} />}
    <Sections sections={sections} />
    {cta && <Cta {...cta} />}
  </main>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
