---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, youtubeId } = post.data;

const formattedDate = new Date(date).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={`${title} | Richard's Guitar Lessons`}
  description={`${title} — news and updates from Richard's Guitar Lessons.`}
  canonical={`https://richardguitarlessons.com/news/${post.id}/`}
  active="news"
>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <article>
      <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">News</p>
      <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">{title}</h1>
      <time class="mt-4 inline-block text-slate-500 dark:text-slate-400" datetime={new Date(date).toISOString()}>{formattedDate}</time>
      {youtubeId && (
        <div class="mt-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <div class="aspect-video">
            <iframe class="h-full w-full" src={`https://www.youtube.com/embed/${youtubeId}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          </div>
        </div>
      )}
      <div class="cms-prose mt-8 text-lg leading-relaxed text-slate-600 dark:text-slate-300">
        <Content />
      </div>
    </article>
    <p class="mt-10 flex flex-wrap gap-6">
      <a href="/news" class="font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-400">← All news</a>
      <a href="/" class="font-semibold text-slate-500 dark:text-slate-400 hover:text-emerald-600 dark:hover:text-emerald-400">Back to home</a>
    </p>
  </main>
</Layout>

<style is:global>
  .cms-prose > * + * { margin-top: 1rem; }
  .cms-prose h2 { margin-top: 2rem; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; }
  .cms-prose h3 { margin-top: 1.5rem; font-size: 1.25rem; font-weight: 600; }
  .cms-prose ul { list-style: disc; padding-left: 1.5rem; }
  .cms-prose ol { list-style: decimal; padding-left: 1.5rem; }
  .cms-prose li + li { margin-top: 0.375rem; }
  .cms-prose a { color: #059669; text-decoration: underline; text-underline-offset: 2px; }
  .cms-prose blockquote { border-left: 4px solid #10b981; padding-left: 1rem; font-style: italic; opacity: 0.9; }
  .cms-prose code { background: rgba(100, 116, 139, 0.18); padding: 0.1em 0.35em; border-radius: 0.25rem; font-size: 0.9em; }
  .cms-prose pre { background: #0f172a; color: #e2e8f0; padding: 1rem; border-radius: 0.75rem; overflow-x: auto; }
  .cms-prose pre code { background: transparent; padding: 0; }
  .cms-prose img { border-radius: 0.75rem; }
  .cms-prose > :first-child { margin-top: 0; }
</style>
