---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection, getEntry } from 'astro:content';

const page = await getEntry('pages', 'news');
if (!page) throw new Error('Missing src/content/pages/news.yml');

const { seo, hero, labels } = page.data;

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title={seo.title}
  description={seo.description}
  canonical="https://richardguitarlessons.com/news"
  ogType="website"
  ogTitle={seo.ogTitle ?? seo.title}
  ogDescription={seo.ogDescription ?? seo.description}
  active="news"
>
  <main>
    <Hero {...hero} />

    <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      {posts.length === 0 ? (
        <p class="rounded-2xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6 text-[var(--theme-muted)]">
          {labels?.empty ?? 'No news yet.'}
        </p>
      ) : (
        <ul class="space-y-6">
          {posts.map((post) => (
            <li class="rounded-2xl border border-[var(--theme-border)] bg-[var(--theme-surface)] p-6 shadow-sm transition hover:border-emerald-300 dark:hover:border-emerald-500">
              <a href={`/news/${post.id}`} class="group block">
                <time class="text-sm text-[var(--theme-faint)]" datetime={new Date(post.data.date).toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                <h2 class="mt-2 text-xl font-bold tracking-tight text-[var(--theme-text)] group-hover:text-emerald-600 dark:group-hover:text-emerald-400">
                  {post.data.title}
                </h2>
                <span class="mt-3 inline-block font-semibold text-emerald-600 dark:text-emerald-400">{labels?.readMore ?? 'Read more →'}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-10">
        <a href="/" class="font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-400">{labels?.backToHome ?? '← Back to home'}</a>
      </p>
    </section>
  </main>
</Layout>
