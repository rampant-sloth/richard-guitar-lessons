---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<Layout
  title="News & Updates | Richard's Guitar Lessons"
  description="News and updates from Richard's Guitar Lessons — new songs, grade exam tips, and what's happening in the studio."
  canonical="https://richardguitarlessons.com/news"
  active="news"
>
  <main class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">News</p>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-5xl">News &amp; updates</h1>
    <p class="mt-4 leading-relaxed text-slate-600 dark:text-slate-300">What's happening in the studio — new songs, exam tips, and the odd bit of guitar geekery.</p>

    {posts.length === 0 ? (
      <p class="mt-10 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 text-slate-600 dark:text-slate-300">No news yet — check back soon.</p>
    ) : (
      <ul class="mt-10 space-y-6">
        {posts.map((post) => (
          <li class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm transition hover:border-emerald-300 dark:hover:border-emerald-500">
            <a href={`/news/${post.id}`} class="group block">
              <time class="text-sm text-slate-500 dark:text-slate-400" datetime={new Date(post.data.date).toISOString()}>{formatDate(post.data.date)}</time>
              <h2 class="mt-2 text-xl font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-emerald-600 dark:group-hover:text-emerald-400">{post.data.title}</h2>
              <span class="mt-3 inline-block font-semibold text-emerald-600 dark:text-emerald-400">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
    )}

    <p class="mt-10">
      <a href="/" class="font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-700 dark:hover:text-emerald-400">← Back to home</a>
    </p>
  </main>
</Layout>
